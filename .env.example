# ==========================================
# Monitor Listrik Pintar (IoT + AI)
# Template Konfigurasi Environment
# Salin file ini ke .env sebelum menjalankan backend
# ==========================================

# Zona Waktu
TZ=Asia/Jakarta

# Konfigurasi Backend & Server
APP_ENV=development
HOST=0.0.0.0
PORT=8000

# Database (Default: SQLite WAL)
DATABASE_URL=sqlite:///./data/energy.db

# MQTT Broker (Mosquitto)
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USER=energy_backend
MQTT_PASS=ganti_password_mqtt_backend

# Keamanan Dashboard & API
DASHBOARD_PASSWORD=ganti_password_dashboard
JWT_SECRET=ganti_jwt_secret_yang_panjang_dan_acak

# Telegram Bot
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_ALLOWED_CHAT_IDS=123456789,987654321

# Integrasi LLM (AI Chat Asisten)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-1.5-flash
LLM_API_KEY=ganti_dengan_api_key_llm
